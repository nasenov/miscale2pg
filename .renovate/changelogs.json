{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Source URL for Spring Boot Gradle plugin",
      "matchPackageNames": [
        "org.springframework.boot:org.springframework.boot.gradle.plugin"
      ],
      "sourceUrl": "https://github.com/spring-projects/spring-boot"
    },
    {
      "description": "Source URL for Spotless Gradle plugin",
      "matchPackageNames": [
        "com.diffplug.spotless:com.diffplug.spotless.gradle.plugin"
      ],
      "sourceUrl": "https://github.com/diffplug/spotless",
      "sourceDirectory": "plugin-gradle"
    }
  ]
}
