{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "Process testcontainers images",
      "customType": "regex",
      "managerFilePatterns": ["/\\.java$/"],
      "matchStrings": [
        "DockerImageName\\.parse\\(\"(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"\\)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
